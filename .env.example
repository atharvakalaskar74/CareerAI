# CareerAI Configuration
FLASK_ENV=development
SECRET_KEY=careerai_super_secret_production_key_btech_cse_2026

# Database Configuration (MySQL or SQLite)
# If using MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/careerai_db
# If empty or not set, default SQLite will be automatically initialized:
DATABASE_URL=sqlite:///instance/careerai.db

# Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB max resume upload
UPLOAD_FOLDER=uploads/resumes

# ML Configuration
MODEL_DIR=ml/saved_models
DEFAULT_RANDOM_STATE=42
