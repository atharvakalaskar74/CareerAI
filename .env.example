# CareerAI — Production & Local Environment Configuration
# Copy this file to .env and customize values for your deployment.

# 1. Flask Application Environment
FLASK_ENV=production
# Generate a secure 32-byte secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secure_hex_key_in_production
PORT=5000
SESSION_COOKIE_SECURE=true

# 2. Database Configuration
# Option A (Recommended for Cloud): Full connection string
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database>?ssl_verify_cert=true

# Option B: Granular MySQL credentials (ideal for local XAMPP or custom cloud host)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=careerai_db
# DB_USER=root
# DB_PASSWORD=

# Option C: Zero-configuration local SQLite fallback (leave DATABASE_URL and DB_HOST unset)
DATABASE_URL=sqlite:///instance/careerai.db

# 3. File Uploads (Ephemeral Container Safe)
MAX_CONTENT_LENGTH=16777216  # 16 MB max resume PDF upload
UPLOAD_FOLDER=uploads/resumes

# 4. Machine Learning Model Configuration
MODEL_DIR=ml/saved_models
DATASET_DIR=ml/dataset
DEFAULT_RANDOM_STATE=42
